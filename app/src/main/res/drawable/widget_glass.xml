<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件：液态玻璃背景。
  说明：小组件是桌面进程画的，RemoteViews 没有“模糊背后壁纸”的能力，
  所以用「半透明 + 高光描边 + 顶部渐亮」还原液态玻璃质感，壁纸会透出来。
  特意不填纯白，避免看起来像一块白板。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/widget_glass_fill" />
            <stroke android:width="1dp" android:color="@color/widget_glass_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:endColor="@android:color/transparent"
                android:startColor="@color/widget_glass_highlight" />
        </shape>
    </item>
</layer-list>
