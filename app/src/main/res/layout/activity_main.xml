<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面：不透明白底。上面是标题/输入/时间/分类/视图切换，中间是列表或日历，下面是统计。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp">

    <!-- 标题栏：设置放在右上角 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_title"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- 输入区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/input_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btn_add"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_add"
            android:contentDescription="@string/add"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_add" />

        <!-- 一键清掉「下一条」还没用到的时间、地点、颜色 -->
        <TextView
            android:id="@+id/btn_reset"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/reset_chip"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 下一条待办用哪个时间 / 哪个颜色 / 哪个地点 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_time"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_pill"
                android:drawableStart="@drawable/ic_clock"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:paddingStart="11dp"
                android:paddingEnd="12dp"
                android:text="@string/time_chip_none"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_color"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/color_chip"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_place"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxWidth="150dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="@string/place_chip"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 视图切换：列表 / 月 / 周 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_list"
            style="@style/FilterTab"
            android:layout_height="36dp"
            android:text="@string/view_list" />

        <TextView
            android:id="@+id/tab_calendar"
            style="@style/FilterTab"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:text="@string/view_calendar" />
    </LinearLayout>

    <!-- 完成状态筛选（只在列表视图显示） -->
    <LinearLayout
        android:id="@+id/filter_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_all"
            style="@style/FilterTab"
            android:layout_height="34dp"
            android:text="@string/tab_all" />

        <TextView
            android:id="@+id/tab_active"
            style="@style/FilterTab"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:text="@string/tab_active" />

        <TextView
            android:id="@+id/tab_done"
            style="@style/FilterTab"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:text="@string/tab_done" />
    </LinearLayout>

    <!-- 日历（月和周的视图） -->
    <LinearLayout
        android:id="@+id/calendar_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_prev"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/calendar_prev"
                android:gravity="center"
                android:text="@string/calendar_prev_mark"
                android:textColor="@color/text_secondary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/calendar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_next"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/calendar_next"
                android:gravity="center"
                android:text="@string/calendar_next_mark"
                android:textColor="@color/text_secondary"
                android:textSize="20sp" />

            <!-- 放大 / 缩小日历：放大后格子里能看到两三个字的内容，一屏一周 -->
            <TextView
                android:id="@+id/btn_zoom"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/calendar_zoom_in"
                android:textColor="?android:attr/colorAccent"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 星期表头：一 ~ 日 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView style="@style/CalendarWeekday" android:text="@string/weekday_1" />
            <TextView style="@style/CalendarWeekday" android:text="@string/weekday_2" />
            <TextView style="@style/CalendarWeekday" android:text="@string/weekday_3" />
            <TextView style="@style/CalendarWeekday" android:text="@string/weekday_4" />
            <TextView style="@style/CalendarWeekday" android:text="@string/weekday_5" />
            <TextView style="@style/CalendarWeekday" android:text="@string/weekday_6" />
            <TextView style="@style/CalendarWeekday" android:text="@string/weekday_7" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/calendar_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 这个月 / 这一周还没有设了时间的待办时给个提示 -->
        <TextView
            android:id="@+id/calendar_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 列表区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:listSelector="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:paddingBottom="4dp"
            android:scrollbarStyle="outsideOverlay" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="@string/empty_hint"
            android:textColor="@color/text_hint"
            android:textSize="15sp" />
    </FrameLayout>

    <!-- 底部统计（列表视图才显示，日历视图把空间留给日历） -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_clear_done"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/clear_done"
            android:textColor="?android:attr/colorAccent"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
